# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL (docker compose --profile data)
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fraudlens
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# MLflow tracking server (docker compose --profile train)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Google Gemini (free key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Free-tier Flash-Lite: ~2 s per note (gemini-3.8-flash took 6-13 s and allows 5 requests/min)
GEMINI_MODEL=gemini-3.5-flash-lite

# Decision threshold, filled in after Phase 6 (falls back to the value stored with the model)
FRAUD_THRESHOLD=

# Where the API loads the model from: mlflow | local | huggingface | s3
MODEL_SOURCE=mlflow
HF_REPO_ID=
HF_TOKEN=

# Grafana admin login (docker compose --profile monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
