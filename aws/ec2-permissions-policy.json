{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListModelBundle",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::fraudlens-ACCOUNT_ID-REGION",
      "Condition": { "StringLike": { "s3:prefix": ["fraudlens-model/*"] } }
    },
    {
      "Sid": "ReadModelBundle",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::fraudlens-ACCOUNT_ID-REGION/fraudlens-model/*"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullApiImage",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": "arn:aws:ecr:REGION:ACCOUNT_ID:repository/fraudlens-api"
    },
    {
      "Sid": "ReadSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/fraudlens/*"
    }
  ]
}
